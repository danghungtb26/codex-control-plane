{
  "name": "codex-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "dashboard:dev": "vite build --config dashboard/vite.config.ts --watch",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "build": "bun run typecheck && bun run dashboard:build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.0",
    "vite": "latest"
  }
}
