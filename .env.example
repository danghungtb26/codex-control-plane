# Required. Use a long random value and put the exact same value in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Comma-separated allowlists. Keep these narrow: trusted webhook commands can cause local code changes.
GITHUB_ALLOWED_REPOS=your-org/your-repo
GITHUB_ALLOWED_SENDERS=your-github-login

# One local HTTP origin for dashboard, admin APIs, SSE and GitHub webhook.
PORT=8787

# Legacy compatibility only. PORT wins when set.
# ADMIN_PORT=8788
# WEBHOOK_PORT=8787

# Codex executable. Usually just "codex" if it is on PATH.
CODEX_BIN=codex

# Used only when CODEX_AUTO_APPROVE=false. In full-access mode network is unrestricted.
CODEX_ALLOW_NETWORK=false

# Default true. WARNING: true means Codex runs with danger-full-access and no approval prompts.
# It can write outside the workspace, mutate .git, execute commands, and access the network.
CODEX_AUTO_APPROVE=true

# Optional. When set, the control plane sends Discord task lifecycle notifications.
# Treat this URL as a secret; do not commit the real value.
DISCORD_WEBHOOK_URL=

# Debounce repeated explicit commands of the same action/target into one turn.
REVIEW_DEBOUNCE_MS=1200

# Docker / Caddy ingress.
# Caddy listens on container port 8080 and Docker binds it to this host port on 127.0.0.1.
CADDY_PORT=8080
CADDY_AUTH_USERNAME=admin

# Set either a plain password or a pre-hashed Caddy password.
# When only CADDY_AUTH_PASSWORD is set, the container hashes it at startup.
CADDY_AUTH_PASSWORD=replace-with-a-strong-password
# CADDY_AUTH_PASSWORD_HASH=

# Optional build-time Codex CLI version. "latest" installs the latest npm release when the image is built.
CODEX_VERSION=latest

# Absolute parent directory containing repositories Codex is allowed to modify.
# docker-compose mounts this directory at the exact same absolute path inside the container so persisted cwd values remain valid.
WORKSPACES_DIR=/absolute/path/to/workspaces

# In Docker this mapping is required for a repository that has no existing local binding yet.
# Every mapped path must live under WORKSPACES_DIR.
REPO_WORKSPACES=your-org/your-repo=/absolute/path/to/workspaces/your-repo

# Optional Git identity used for commits created inside the container.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional recovery/advanced overrides.
# GH_BIN=gh
