# Required. Use a long random value and put the exact same value in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Comma-separated allowlists. Keep these narrow: webhook comments can cause local code changes.
GITHUB_ALLOWED_REPOS=your-org/your-repo
GITHUB_ALLOWED_SENDERS=your-github-login

# Local ports. Only WEBHOOK_PORT should be exposed through a tunnel.
WEBHOOK_PORT=8787
ADMIN_PORT=8788

# Codex executable. Usually just "codex" if it is on PATH.
CODEX_BIN=codex

# Required if Codex itself must push/create PRs/comment on GitHub.
CODEX_ALLOW_NETWORK=false

# Default true. Uses Codex on-request approvals with auto-review and accepts any approval
# request still surfaced by App Server. Set false to restore deny-all behavior.
CODEX_AUTO_APPROVE=true

# Optional. When set, the control plane sends a Discord notification whenever a tracked Codex turn completes.
# Treat this URL as a secret; do not commit the real value.
DISCORD_WEBHOOK_URL=

# Collect several GitHub review events into one Codex message.
REVIEW_DEBOUNCE_MS=1200

# Forward inline PR review comments to Codex.
FORWARD_INLINE_REVIEW_COMMENTS=true

# Optional recovery/advanced overrides. Most local setups do not need these.
# REPO_WORKSPACES=your-org/your-repo=/absolute/path/to/repo
# GH_BIN=gh
