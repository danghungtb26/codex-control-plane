# Required. Use a long random value and put the exact same value in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Comma-separated allowlists. Keep these narrow: webhook comments can cause local code changes.
GITHUB_ALLOWED_REPOS=your-org/your-repo
GITHUB_ALLOWED_SENDERS=your-github-login

# Local ports. Only WEBHOOK_PORT should be exposed through a tunnel.
WEBHOOK_PORT=8787
ADMIN_PORT=8788

# Codex executable. Usually just "codex" if it is on PATH.
CODEX_BIN=codex

# Safe default: Codex can write the workspace but has no network access.
# Turn this on only if you want commands such as git push / gh to reach GitHub.
CODEX_ALLOW_NETWORK=false

# Collect several GitHub review events into one Codex message.
REVIEW_DEBOUNCE_MS=1200

# Optional. Set to false if you only want review summaries / manual PR comments,
# not individual inline review comments.
FORWARD_INLINE_REVIEW_COMMENTS=true
