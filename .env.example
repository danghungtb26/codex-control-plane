# Required. Use a long random value and put the exact same value in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Comma-separated allowlists. Keep these narrow: trusted webhook commands can cause local code changes.
GITHUB_ALLOWED_REPOS=your-org/your-repo
GITHUB_ALLOWED_SENDERS=your-github-login

# Native core service. Keep Codex, gh, git and repository workspaces on the host.
PORT=8787

# Legacy compatibility only. PORT wins when set.
# ADMIN_PORT=8788
# WEBHOOK_PORT=8787

# Codex executable. Usually just "codex" if it is on PATH.
CODEX_BIN=codex

# Used only when CODEX_AUTO_APPROVE=false. In full-access mode network is unrestricted.
CODEX_ALLOW_NETWORK=false

# Default true. WARNING: true means Codex runs with danger-full-access and no approval prompts.
# It can write outside the workspace, mutate .git, execute commands, and access the network.
CODEX_AUTO_APPROVE=true

# Optional. When set, the control plane sends Discord task lifecycle notifications.
# Treat this URL as a secret; do not commit the real value.
DISCORD_WEBHOOK_URL=

# Debounce repeated explicit commands of the same action/target into one turn.
REVIEW_DEBOUNCE_MS=1200

# Optional recovery/advanced overrides for the native core service.
# REPO_WORKSPACES=your-org/your-repo=/absolute/path/to/repo
# GH_BIN=gh

# Docker dashboard / ingress only.
CADDY_PORT=8080
CADDY_AUTH_USERNAME=admin

# Set either a plain password or a pre-hashed Caddy password.
# When only CADDY_AUTH_PASSWORD is set, the dashboard container hashes it at startup.
CADDY_AUTH_PASSWORD=
# CADDY_AUTH_PASSWORD_HASH=

# Address used by Caddy inside Docker to reach the native core service.
CORE_URL=http://host.docker.internal:8787
